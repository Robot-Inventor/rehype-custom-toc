{
  "name": "rehype-custom-toc",
  "version": "1.1.7",
  "description": "rehype plugin to generate a customizable table of contents",
  "keywords": [
    "hast",
    "html",
    "markdown",
    "rehype",
    "toc",
    "unified"
  ],
  "homepage": "https://github.com/Robot-Inventor/rehype-custom-toc#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/rehype-custom-toc/issues"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/rehype-custom-toc.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "test": "cross-env NODE_ENV=\"production\" vitest",
    "lint": "oxlint ./src",
    "build": "tsc",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "ci:version": "changeset version",
    "ci:publish": "npm run build && changeset publish"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-text": "^4.0.3",
    "hastscript": "^9.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "unist-util-visit-parents": "^6.1.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@robot-inventor/oxlint-config": "^1.2.0",
    "@robot-inventor/tsconfig-base": "^7.2.0",
    "@types/hast": "^3.0.5",
    "cross-env": "^10.1.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-comment": "^1.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
